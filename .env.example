# Copy to .env (never commit it) and load with: set -a; source .env; set +a
# Data directory (database, documents, evidence). Keep it on an encrypted disk.
JOBAGENT_HOME=./var
# Fernet key that encrypts the candidate profile at rest. Generate: python -m jobagent.cli keygen
JOBAGENT_ENCRYPTION_KEY=
# discovery | review | auto. Leave empty to use config.yaml, which the dashboard's Run page sets.
JOBAGENT_MODE=
# Optional: Claude for wording (bullet polish, cover letters). Leave empty to run fully deterministic.
ANTHROPIC_API_KEY=
JOBAGENT_ANTHROPIC_MODEL=claude-opus-5-5
# Set to 0 to disable the model even when a key is present
JOBAGENT_LLM=1
# Optional: require this token to open the dashboard (?token=... once, then a cookie)
JOBAGENT_DASHBOARD_TOKEN=
# Optional: path to a Chromium binary if Playwright's bundled browser is not installed
JOBAGENT_CHROMIUM_PATH=
# Set to 1 to watch the browser while it fills forms
JOBAGENT_HEADFUL=0
# Optional: app password for reading LinkedIn/Indeed/Naukri alert emails over IMAP (read-only).
# config.yaml names this variable (password_env); the password itself never goes in config.yaml.
JOBAGENT_IMAP_PASSWORD=
# Optional: browser for `jobagent capture`, e.g. chrome to use your installed Google Chrome
JOBAGENT_BROWSER_CHANNEL=
