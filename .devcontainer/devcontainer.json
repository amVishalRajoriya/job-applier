{
  "name": "Job Applier",
  "image": "mcr.microsoft.com/playwright/python:v1.64.0-noble",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "containerEnv": { "PIP_BREAK_SYSTEM_PACKAGES": "1" },
  "onCreateCommand": "python3 -m pip install -q -r requirements.txt",
  "postStartCommand": "bash .devcontainer/run.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Job Applier", "onAutoForward": "openBrowser", "visibility": "private" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/HOSTING_GUIDE.md"] }
  }
}
