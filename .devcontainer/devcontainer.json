{
  "name": "Job Applier",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "onCreateCommand": "pip install --user -q -r requirements.txt && python3 -m playwright install --with-deps chromium",
  "postStartCommand": "bash .devcontainer/run.sh",
  "postAttachCommand": "bash .devcontainer/run.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Job Applier", "onAutoForward": "openBrowser", "visibility": "private" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/HOW_TO_OPEN.md"] }
  }
}
